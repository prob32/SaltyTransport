	# =====================================================================
	# SHARED ACCESS TOOLTIP BODY
	# =====================================================================

	type stl_access_tooltip_body = flowcontainer {
		direction = vertical
		minimumsize = { 420 0 }
		maximumsize = { 440 2000 }
		margin = { 8 4 }
		spacing = 4

		# Header
		flowcontainer = {
			direction = vertical
			spacing = 2
			textbox = {
				visible = "[GreaterThan_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_display_is_import'), '(CFixedPoint)0')]"
				raw_text = "#bold Trade Partners — Supply Access#!"
				autoresize = yes
				fontsize = 16
			}
			textbox = {
				visible = "[Not(GreaterThan_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_display_is_import'), '(CFixedPoint)0'))]"
				raw_text = "#bold Trade Partners — Demand Access#!"
				autoresize = yes
				fontsize = 16
			}
			textbox = {
				raw_text = "[GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_display_partner_count')|v0] partners connected"
				autoresize = yes
				fontsize = 13
				fontcolor = { 0.7 0.7 0.6 1 }
				margin_bottom = 2
			}
		}

		# Column headers
		flowcontainer = {
			direction = horizontal
			spacing = 4
			textbox = { raw_text = "#bold State#!" size = { 110 20 } fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } }
			textbox = { raw_text = "#bold Qty#!" size = { 45 20 } align = right|nobaseline fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } }
			textbox = { raw_text = "#bold Share#!" size = { 50 20 } align = right|nobaseline fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } }
			textbox = { raw_text = "#bold Price#!" size = { 50 20 } align = right|nobaseline fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } }
			textbox = { visible = "[GreaterThan_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_display_is_import'), '(CFixedPoint)0')]" raw_text = "#bold Transport#!" size = { 60 20 } align = right|nobaseline fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } }
			textbox = { raw_text = "#bold Proximity#!" size = { 60 20 } align = right|nobaseline fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } }
		}

		# Partner list
		dynamicgridbox = {
			datamodel = "[Building.GetState.MakeScope.GetList('stl_display_partners')]"
			item = {
				flowcontainer = {
					datacontext = "[Scope.GetState]"
					direction = horizontal
					spacing = 4
					margin_left = 2
					textbox = { raw_text = "[State.GetName]" size = { 110 20 } fontsize = 14 elide = right }
					textbox = { raw_text = "[GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_qty')|v1]" size = { 45 20 } align = right|nobaseline fontsize = 14 }
					textbox = { visible = "[GreaterThan_CFixedPoint(GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_pct'), '(CFixedPoint)4.9')]" raw_text = "#G [GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_pct')|1]%#!" size = { 50 20 } align = right|nobaseline fontsize = 14 }
					textbox = { visible = "[And(GreaterThan_CFixedPoint(GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_pct'), '(CFixedPoint)0.9'), Not(GreaterThan_CFixedPoint(GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_pct'), '(CFixedPoint)4.9')))]" raw_text = "#Y [GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_pct')|1]%#!" size = { 50 20 } align = right|nobaseline fontsize = 14 }
					textbox = { visible = "[Not(GreaterThan_CFixedPoint(GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_pct'), '(CFixedPoint)0.9'))]" raw_text = "#R [GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_display_contribution_pct')|1]%#!" size = { 50 20 } align = right|nobaseline fontsize = 14 }
					widget = {
						size = { 50 20 }
						textbox = { visible = "[EqualTo_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_display_good_idx'), '(CFixedPoint)1')]" raw_text = "@money![GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_partner_price_grain')|v1]" size = { 50 20 } align = right|nobaseline fontsize = 14 }
						textbox = { visible = "[EqualTo_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_display_good_idx'), '(CFixedPoint)2')]" raw_text = "@money![GuiScope.SetRoot(State.MakeScope).ScriptValue('stl_gui_partner_price_fish')|v1]" size = { 50 20 } align = right|nobaseline fontsize = 14 }
