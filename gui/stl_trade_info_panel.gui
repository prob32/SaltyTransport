							textbox = { visible = "[Not(GreaterThan_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_revenue_export_fine_art'), '(CFixedPoint)0'))]" raw_text = "#R @money![GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_revenue_export_fine_art')|v1]#!" parentanchor = right|vcenter autoresize = yes fontsize = 17 }
						}
					}
				}

			}
		}

	}
}
