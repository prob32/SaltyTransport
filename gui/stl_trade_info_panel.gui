# ========================================
# SALTY TRANSPORT - Trade Info Panel v7
#
# Auto-generated by tools/generate_goods.py
# Infrastructure friction + transport cost system, 49 tradeable goods.
# ========================================

@stl_panel_w = 550
@stl_row_h = 38
@stl_col_good = 130
@stl_col_import = 65
@stl_col_local = 70
@stl_col_market = 75
@stl_col_transport = 70
@stl_col_revenue = 100

