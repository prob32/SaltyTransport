				size = { @stl_panel_w 38 }
				blockoverride "left_text" { text = "STL_SECTION_EXPORTS" }
				blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('stl_exports_expanded')]" }
				blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('stl_exports_expanded'))]" }
				blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('stl_exports_expanded')]" }
