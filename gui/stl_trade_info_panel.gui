	# =====================================================================
	# MAIN PANEL
	# =====================================================================

	type stl_trade_info_section = flowcontainer {
		direction = vertical
		using = default_list_position
		minimumsize = { @stl_panel_w 0 }
		margin_bottom = 10

		# Header: Trade Distribution
		default_header_2texts = {
			blockoverride "text1" { text = "STL_TRADE_DISTRIBUTION" }
			blockoverride "right" {
				flowcontainer = {
					parentanchor = right|vcenter
					margin_right = 15
					spacing = 5
					textbox = { text = "STL_NETWORK_SUMMARY" autoresize = yes fontsize = 16 fontcolor = { 0.7 0.7 0.6 1 } }
					textbox = { raw_text = "#bold [GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_partner_count')|v0]#! partners" autoresize = yes fontsize = 16 }
				}
			}
		}

		# ===== IMPORTS SECTION =====
		flowcontainer = {
			direction = vertical
			visible = "[GreaterThan_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_any_import'), '(CFixedPoint)0')]"

			section_header_button = {
				parentanchor = right
				position = { 0 2 }
				size = { @stl_panel_w 38 }
				blockoverride "left_text" { text = "STL_SECTION_IMPORTS" }
				blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('stl_imports_expanded')]" }
				blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('stl_imports_expanded'))]" }
				blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('stl_imports_expanded')]" }
			}

			flowcontainer = {
				visible = "[GetVariableSystem.Exists('stl_imports_expanded')]"
				direction = vertical
				margin = { 8 4 }
				spacing = 2

				# Column headers
				flowcontainer = {
					direction = horizontal
					minimumsize = { @stl_panel_w 24 }
					spacing = 4
					margin_left = 4
					textbox = { text = "STL_COL_GOOD" size = { @stl_col_good 24 } fontsize = 14 fontcolor = { 0.7 0.7 0.6 1 } }
					textbox = { text = "STL_HEADER_IMPORT" size = { @stl_col_import 24 } align = right|nobaseline fontsize = 14 fontcolor = { 0.7 0.7 0.6 1 } }
					textbox = { text = "STL_HEADER_LOCAL_PRICE" size = { @stl_col_local 24 } align = right|nobaseline fontsize = 14 fontcolor = { 0.7 0.7 0.6 1 } }
					textbox = { text = "STL_HEADER_MARKET_PRICE" size = { @stl_col_market 24 } align = right|nobaseline fontsize = 14 fontcolor = { 0.7 0.7 0.6 1 } }
					textbox = { text = "STL_HEADER_TRANSPORT" size = { @stl_col_transport 24 } align = right|nobaseline fontsize = 14 fontcolor = { 0.7 0.7 0.6 1 } }
					textbox = { text = "STL_HEADER_REVENUE" size = { @stl_col_revenue 24 } align = right|nobaseline fontsize = 14 fontcolor = { 0.7 0.7 0.6 1 } }
				}

				### GRAIN IMPORT CARD
				button = {
					size = { @stl_panel_w @stl_row_h }
					visible = "[GreaterThan_CFixedPoint(GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_deficit_grain'), '(CFixedPoint)0')]"
					using = default_button
					onclick = "[InformationPanelBar.OpenGoodsStatePanel(Building.GetState, GetGoods('grain'))]"
					using = select_button_sound
					flowcontainer = {
						direction = horizontal
						parentanchor = vcenter
						spacing = 4
						margin_left = 4
						widget = {
							size = { @stl_col_good 34 }
							textbox = { raw_text = "#bold [GetGoods('grain').GetName]#!" size = { @stl_col_good 34 } parentanchor = vcenter fontsize = 17 align = left|nobaseline elide = right }
						}
						widget = {
							size = { @stl_col_import 34 }
							tooltipwidget = { stl_tt_import_grain = {} }
							textbox = { raw_text = "#R #bold [GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_import_grain')|v1]#!#!" parentanchor = right|vcenter autoresize = yes fontsize = 17 }
						}
						widget = {
							size = { @stl_col_local 34 }
							tooltipwidget = { TooltipWidgetType = { blockoverride "tooltip_content_after" { flowcontainer = { direction = vertical margin = { 8 6 } minimumsize = { 320 0 } spacing = 2 textbox = { raw_text = "#bold Local Price: [GetGoods('grain').GetName]#!" autoresize = yes fontsize = 16 } widget = { size = { 5 4 } } textbox = { raw_text = "#bold Formula:#! BASE × (1 + pricier)" autoresize = yes fontsize = 14 } textbox = { raw_text = "  base = 20  pricier = [GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_direct_pricier_grain')|3]" autoresize = yes fontsize = 13 fontcolor = { 0.7 0.7 0.6 1 } } textbox = { raw_text = "  = 20 × (1 + [GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_direct_pricier_grain')|3])" autoresize = yes fontsize = 13 fontcolor = { 0.7 0.7 0.6 1 } } textbox = { raw_text = "  = @money![GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_local_price_grain')|v3]" autoresize = yes fontsize = 15 } widget = { size = { 5 4 } } textbox = { raw_text = "#bold Market price#! (buy/sell equilibrium):" autoresize = yes fontsize = 14 } textbox = { raw_text = "  = @money![GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_market_price_grain')|v3]" autoresize = yes fontsize = 14 } } } } }
							textbox = { raw_text = "@money![GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_local_price_grain')|v1]" parentanchor = right|vcenter autoresize = yes fontsize = 17 }
						}
						widget = {
							size = { @stl_col_market 34 }
							tooltipwidget = { TooltipWidgetType = { blockoverride "tooltip_content_after" { flowcontainer = { direction = vertical margin = { 8 4 } minimumsize = { 280 0 } spacing = 2 textbox = { raw_text = "#bold Weighted Avg Source Price#!" autoresize = yes fontsize = 16 } textbox = { raw_text = "Average of local prices across import sources, weighted by production share and proximity." autoresize = yes fontsize = 14 } textbox = { raw_text = "Closer partners with more surplus have more influence." autoresize = yes fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } } textbox = { raw_text = "Hover the quantity column to refresh from current partner data." autoresize = yes fontsize = 13 fontcolor = { 0.6 0.6 0.5 1 } } } } } }
							textbox = { raw_text = "@money![GuiScope.SetRoot(Building.GetState.MakeScope).ScriptValue('stl_gui_weighted_avg_price_grain')|v1]" parentanchor = right|vcenter autoresize = yes fontsize = 17 }
						}
						widget = {
							size = { @stl_col_transport 34 }
