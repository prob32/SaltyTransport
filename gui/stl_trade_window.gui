# Standalone movable Internal Trade window, registered via
# gui/scripted_widgets/stl_widgets.txt. Opened by stl_sgui_open_window
# (depot panel button sets var:stl_window_state on the player country).

@stl_win_w       = 760
@stl_row_h       = 26
@stl_col_good    = 170
@stl_col_num     = 78

window = {
	name = "stl_trade_window"
	parentanchor = top|left
	position = { 480 120 }
	size = { @stl_win_w 720 }
	layer = windows_layer
	filter_mouse = all
	allow_outside = yes
	movable = yes

	using = Window_Background
	using = Window_Decoration

	datacontext = "[GetPlayer]"
	visible = "[Country.MakeScope.Var('stl_window_state').IsSet]"
	datacontext = "[Country.MakeScope.Var('stl_window_state').GetState]"

	state = { name = _show using = Animation_FadeIn_Quick }
	state = { name = _hide using = Animation_FadeOut_Quick }

	vbox = {
		restrictparent_min = yes
		using = Window_Margins

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "stl_trade_window_title"
			}
			blockoverride "button_close" {
				onclick = "[GetScriptedGui('stl_sgui_close_window').Execute(GuiScope.SetRoot(Country.MakeScope).End)]"
			}
		}

		textbox = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			align = center
			using = fontsize_large
			text = "[State.GetName]"
		}

		# column headers
		hbox = {
			layoutpolicy_horizontal = expanding
			textbox = { minimumsize = { @stl_col_good @stl_row_h } align = left   text = "stl_trade_window_col_good" }
			textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right  text = "stl_trade_window_col_amount" }
			textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right  text = "stl_trade_window_col_target" }
			textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right  text = "stl_trade_window_col_access" }
			textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right  text = "stl_trade_window_col_local" }
