		# empty state
		textbox = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			align = center
			text = "stl_trade_window_no_trade"
			visible = "[Not(GetScriptedGui('stl_sgui_has_trade').IsValid(GuiScope.SetRoot(State.MakeScope).End))]"
		}

		# partner breakdown (filled by stl_show_import_/export_<good>)
		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[DataModelHasItems(State.MakeScope.GetList('stl_display_partners'))]"

			divider_clean = {
				layoutpolicy_horizontal = expanding
			}
			textbox = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				align = left
				using = fontsize_large
				text = "stl_trade_window_partners"
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				textbox = { minimumsize = { @stl_col_good @stl_row_h } align = left  text = "stl_trade_window_col_partner" }
				textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right text = "stl_trade_window_col_friction" }
				textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right text = "stl_trade_window_col_weight" }
				textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right text = "stl_trade_window_col_price" }
				textbox = { minimumsize = { @stl_col_num  @stl_row_h } align = right text = "stl_trade_window_col_share" }
			}
			scrollbox = {
				layoutpolicy_horizontal = expanding
				minimumsize = { -1 120 }
				maximumsize = { -1 240 }

				blockoverride "scrollbox_content"
				{
					dynamicgridbox = {
						datamodel = "[State.MakeScope.GetList('stl_display_partners')]"
						item = {
							widget = {
								datacontext = "[Scope.GetState]"
								size = { @stl_win_w @stl_row_h }
								hbox = {
									textbox = {
										minimumsize = { @stl_col_good @stl_row_h }
										align = left
										text = "[State.GetName]"
									}
									textbox = { minimumsize = { @stl_col_num @stl_row_h } align = right text = "[State.MakeScope.ScriptValue('stl_sv_display_friction')|0]" }
									textbox = { minimumsize = { @stl_col_num @stl_row_h } align = right text = "[State.MakeScope.ScriptValue('stl_sv_display_weight')|0]" }
									textbox = { minimumsize = { @stl_col_num @stl_row_h } align = right text = "£[State.MakeScope.ScriptValue('stl_sv_display_source_price')|1]" }
									textbox = { minimumsize = { @stl_col_num @stl_row_h } align = right text = "[State.MakeScope.ScriptValue('stl_sv_display_contribution')|0]%" }
								}
							}
						}
					}
				}
			}
			button = {
				size = { 160 26 }
				using = default_button
				text = "stl_trade_window_clear"
				onclick = "[GetScriptedGui('stl_sgui_clear_display').Execute(GuiScope.SetRoot(State.MakeScope).End)]"
			}
		}
	}
